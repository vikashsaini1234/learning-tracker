# -----------------------------
# Global Environment Variables
# -----------------------------

# Spring Boot App
SPRING_APP_NAME=learning-tracker-api
SPRING_PROFILES_ACTIVE=default
SERVER_PORT=8080

# MySQL Database
MYSQL_DB=learning_tracker
MYSQL_USER=tracker_user
MYSQL_PASSWORD=tracker_pass
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_PORT=3306

# Docker Network
NETWORK_NAME=learning-tracker-net
